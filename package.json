{
  "name": "@mndr/langchain-azure-otel",
  "version": "0.1.0",
  "description": "OpenTelemetry GenAI tracing for LangChain/LangGraph JS with Azure AI Foundry and Application Insights",
  "type": "module",
  "license": "MIT",
  "author": "MNDR",
  "repository": {
    "type": "git",
    "url": "https://github.com/heymndr/langchain-azure-otel"
  },
  "homepage": "https://github.com/heymndr/langchain-azure-otel#readme",
  "bugs": {
    "url": "https://github.com/heymndr/langchain-azure-otel/issues"
  },
  "keywords": [
    "opentelemetry",
    "langchain",
    "langgraph",
    "azure",
    "ai-foundry",
    "application-insights",
    "tracing",
    "gen-ai",
    "semantic-conventions",
    "observability"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@langchain/core": ">=0.2.0",
    "@opentelemetry/api": "^1.3.0"
  },
  "devDependencies": {
    "@langchain/core": "^1.1.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-base": "^2.0.0",
    "@opentelemetry/sdk-trace-node": "^2.0.0",
    "@types/node": "^20.0.0",
    "rimraf": "^6.0.0",
    "typescript": "~5.8.0",
    "vitest": "^3.0.0"
  },
  "scripts": {
    "build": "npm run clean && npm run build:esm && npm run build:cjs",
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "clean": "rimraf dist",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm run test"
  }
}
